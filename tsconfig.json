{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,

    // Type-check JS opt-in per file via `// @ts-check`. Enabling checkJs
    // project-wide currently reports ~770 errors, so files are migrated
    // gradually (or renamed to .ts) rather than all at once.
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,

    // Deliberately loose: this is a gradual migration, not a rewrite.
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "allowUnreachableCode": true,

    // Guard rails that are cheap and catch real bugs.
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    // TS 6+ no longer auto-includes every @types package.
    "types": ["firefox-webext-browser", "node"]
  },
  "include": ["src/**/*.js", "src/**/*.ts", "src/**/*.tsx", "test/**/*.ts", "build.js"],
  "exclude": ["node_modules", "dist"]
}
